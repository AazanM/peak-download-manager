{
  "manifest_version": 3,
  "name": "Peak Download Manager",
  "version": "1.0.0",
  "description": "Download MP3 or video from YouTube, Pinterest, Instagram, TikTok, X and more in one click.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:7878/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Peak Download Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "grab-mp3": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Download current page as MP3"
    },
    "grab-video": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Download current page as video"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "http://127.0.0.1:7878/*"
      ],
      "js": [
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:7878/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/mark.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}